                    name: "Attack",
                    attack: "Claw",
                    cost: 1,
                ),
                (
                    name: "Chomp",
                    attack: "Bite",
                    cost: 2,
                ),
            ],
            legendary_points: 3,
            legendary_resistance: 3,
        )),
