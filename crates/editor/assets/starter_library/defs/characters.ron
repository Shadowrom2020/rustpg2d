            abilities: (18, 14, 15, 11, 17, 16),
            ac: 12,
            hp: 67,
            hit_dice: "9d10+18",
            speed_ft: 50,
            darkvision_ft: 60,
            proficiencies: [],
            languages: "Celestial, Elvish, Sylvan, telepathy 60 ft.",
            alignment: "lawful good",
            cr: "5",
            xp: 1800,
            immunities: [
                "poison",
            ],
            condition_immunities: [
                "charmed",
                "paralyzed",
                "poisoned",
            ],
            attacks: [
                (
                    name: "Hooves",
                    bonus: 7,
                    dice: "2d6+4",
                    damage_type: Some(Bludgeoning),
                    reach_ft: 5,
                ),
                (
                    name: "Horn",
                    bonus: 7,
                    dice: "1d8+4",
                    damage_type: Some(Piercing),
                    reach_ft: 5,
                ),
            ],
            multiattack: 2,
            size: Large,
            creature_type: "celestial",
            senses: "darkvision 60 ft., passive Perception 13",
            features: [
                (
                    kind: Trait,
                    name: "Charge",
                    text: "If the unicorn moves at least 20 ft. straight toward a target and then hits it with a horn attack on the same turn, the target takes an extra 9 (2d8) piercing damage. If the target is a creature, it must succeed on a DC 15 Strength saving throw or be knocked prone.",
                ),
                (
                    kind: Trait,
                    name: "Innate Spellcasting",
                    text: "The unicorn\'s innate spellcasting ability is Charisma (spell save DC 14). The unicorn can innately cast the following spells, requiring no components:\n\nAt will: detect evil and good, druidcraft, pass without trace\n1/day each: calm emotions, dispel evil and good, entangle",
                ),
                (
                    kind: Trait,
                    name: "Magic Resistance",
                    text: "The unicorn has advantage on saving throws against spells and other magical effects.",
                ),
                (
                    kind: Trait,
                    name: "Magic Weapons",
                    text: "The unicorn\'s weapon attacks are magical.",
                ),
                (
                    kind: Action,
                    name: "Multiattack",
                    text: "The unicorn makes two attacks: one with its hooves and one with its horn.",
                ),
                (
                    kind: Action,
                    name: "Hooves",
                    text: "Melee Weapon Attack: +7 to hit, reach 5 ft., one target. Hit: 11 (2d6 + 4) bludgeoning damage.",
                ),
                (
                    kind: Action,
                    name: "Horn",
                    text: "Melee Weapon Attack: +7 to hit, reach 5 ft., one target. Hit: 8 (1d8 + 4) piercing damage.",
                ),
                (
                    kind: Action,
                    name: "Healing Touch",
                    text: "The unicorn touches another creature with its horn. The target magically regains 11 (2d8 + 2) hit points. In addition, the touch removes all diseases and neutralizes all poisons afflicting the target.",
                ),
                (
                    kind: Action,
                    name: "Teleport",
                    text: "The unicorn magically teleports itself and up to three willing creatures it can see within 5 ft. of it, along with any equipment they are wearing or carrying, to a location the unicorn is familiar with, up to 1 mile away.",
                ),
                (
                    kind: Legendary,
                    name: "Hooves",
                    text: "The unicorn makes one attack with its hooves.",
                ),
                (
                    kind: Legendary,
                    name: "Shimmering Shield (Costs 2 Actions)",
                    text: "The unicorn creates a shimmering, magical field around itself or another creature it can see within 60 ft. of it. The target gains a +2 bonus to AC until the end of the unicorn\'s next turn.",
                ),
                (
                    kind: Legendary,
                    name: "Heal Self (Costs 3 Actions)",
                    text: "The unicorn magically regains 11 (2d8 + 2) hit points.",
                ),
            ],
            spellcasting: Some((
                ability: Cha,
                dc: 14,
                attack: 6,
                spells: [
                    (
                        spell: "detect-evil-and-good",
                        level: 1,
                        innate: true,
                    ),
                    (
                        spell: "druidcraft",
                        level: 0,
                        innate: true,
                    ),
                    (
                        spell: "pass-without-trace",
