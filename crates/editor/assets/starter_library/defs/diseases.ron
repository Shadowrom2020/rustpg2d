[
    (
        id: "cackle_fever",
        name: "Cackle Fever",
        description: "This disease targets humanoids. Victims frequently succumb to fits of mad laughter, giving the disease its common name and its morbid nickname: \"the shrieks.\" Symptoms manifest 1d4 hours after infection and include fever and disorientation. The infected creature gains one level of exhaustion that can\'t be removed until the disease is cured. Taking damage forces the creature to make a DC 13 Constitution saving throw. On a failed save, the creature takes 5 (1d10) psychic damage and becomes incapacitated with mad laughter for 1 minute. At the end of each long rest, an infected creature can make a DC 13 Constitution saving throw. On a successful save, the DC for this save and for the save to avoid an attack of mad laughter drops by 1d6. When the saving throw DC drops to 0, the creature recovers from the disease.",
        save: Con,
        dc: 13,
        onset: "1d4",
        exhaustion: 1,
        keeps_exhaustion: true,
        when_hurt: Some((
            damage: "1d10",
            damage_type: Some(Psychic),
            condition: Some(Incapacitated),
            seconds: 60.0,
        )),
        course: ShrinkingDc(
            dice: "1d6",
        ),
    ),
    (
        id: "sewer_plague",
        name: "Sewer Plague",
        description: "Sewer plague is a generic term for a broad category of illnesses that incubate in sewers, refuse heaps, and stagnant swamps, and which are sometimes transmitted by creatures that dwell in those areas, such as rats and otyughs. A creature bitten by a carrier, or that comes into contact with contaminated filth, must succeed on a DC 11 Constitution saving throw or become infected. It takes 1d4 days for the symptoms to manifest: fatigue and cramps. The infected creature suffers one level of exhaustion, and it regains only half the normal number of hit points from spending Hit Dice and no hit points from finishing a long rest. At the end of each long rest, an infected creature must make a DC 11 Constitution saving throw. On a failed save, the character gains one level of exhaustion. On a successful save, the character\'s exhaustion level decreases by one level. If a successful saving throw reduces the infected creature\'s level of exhaustion below 1, the creature recovers from the disease.",
        save: Con,
        dc: 11,
        onset: "1d4",
        onset_days: true,
        exhaustion: 1,
        keeps_exhaustion: true,
        no_rest_healing: true,
        half_hit_dice: true,
        course: Exhaustion,
    ),
    (
        id: "sight_rot",
        name: "Sight Rot",
        description: "This painful infection causes bleeding from the eyes and eventually blinds the victim. A creature that drinks water tainted by sight rot must succeed on a DC 15 Constitution saving throw or become infected. One day after infection, the creature\'s vision starts to become blurry. The creature takes a -1 penalty to attack rolls and ability checks that rely on sight. At the end of each long rest after the symptoms appear, the penalty worsens by 1. When it reaches -5, the victim is blinded until its sight is restored by magic such as lesser restoration or heal.",
        save: Con,
        dc: 15,
        onset: "1",
        onset_days: true,
        sight: true,
        course: Worsens,
    ),
    (
        id: "rat_bite_fever",
        name: "Rat-Bite Fever",
        description: "The bite of a diseased giant rat festers. Until the disease is cured, the creature can\'t regain hit points except by magical means, and its hit point maximum decreases by 3 (1d6) every 24 hours. If its hit point maximum drops to 0 as a result of this disease, the creature dies. A healer or a spell such as lesser restoration cures it.",
        save: Con,
        dc: 10,
        no_natural_healing: true,
        max_hp_loss: "1d6",
        course: r#None,
    ),
]