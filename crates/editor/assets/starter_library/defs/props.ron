                            state: "lit",
                        ),
                        negate: true,
                    ),
                ],
                actions: [
                    Dialog(
                        speaker: "",
                        text: "The campfire is cold. Use a log on it to light it.",
                    ),
                ],
                once: false,
            ),
            (
                on: UseItem(
                    item: "log",
                ),
                conditions: [
                    (
                        cond: PropState(
                            target: "self",
                            state: "lit",
                        ),
                        negate: true,
                    ),
                ],
                actions: [
                    TakeItem(
                        item: "log",
                        count: 1,
                    ),
                    SetState(
                        target: "self",
                        state: "lit",
                    ),
                    Dialog(
                        speaker: "",
                        text: "You stack the logs and the fire crackles to life.",
                    ),
                ],
                once: false,
            ),
            (
                on: UseItem(
                    item: "log",
                ),
                conditions: [
                    (
                        cond: PropState(
                            target: "self",
                            state: "lit",
                        ),
                        negate: false,
                    ),
                ],
                actions: [
                    Dialog(
                        speaker: "",
                        text: "The fire is burning well already.",
                    ),
                ],
                once: false,
            ),
