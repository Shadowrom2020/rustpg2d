(
    name: "Hard mode",
    version: "1.0",
    author: "R(ust)PG2D",
    description: "Enemies hit harder and healing helps less. A red \"Hard mode\" under the clock says it is on.",
    api: "0.27",
    parameters: [
        (
            name: "damage",
            label: "Damage taken ×",
            default: Some(2.0),
            min: 1.0,
            max: 5.0,
            help: "Hits on the player and their companions hurt this many times as much",
        ),
        (
            name: "healing",
            label: "Healing ×",
            default: Some(0.75),
            min: 0.1,
            max: 1.0,
            help: "Healing the player and their companions get (potions, spells, food): 1 = as usual",
        ),
    ],
    hooks: [
        (
            hook: "damage",
            function: "hard_mode_damage",
            priority: 100,
        ),
        (
            hook: "heal",
            function: "hard_mode_heal",
            priority: 100,
        ),
    ],
    hud: {
        "badge": (
            kind: Text(
                text: "Hard mode",
            ),
            anchor: TopRight,
            x: 14.0,
            y: 66.0,
            color: "red",
        ),
    },
)
