[
    (
        id: "strange_lights",
        title: "The Strange Lights",
        description: "Strange lights have been seen in Whisperwood, east of Emberbrook. Elder Rowan asked me to investigate the old shrine there.",
        stages: [
            "Take the gate key from the chest in Elder Rowan\'s house, east of the market square.",
            "Open the east gate and find the old shrine deep in Whisperwood.",
            "Return to Elder Rowan.",
        ],
        xp: 80,
        targets: [
            (
                map: "house",
                name: "gate_key_chest",
            ),
            (
                map: "forest",
                name: "shrine",
            ),
            (
                map: "village",
                name: "elder",
            ),
        ],
        giver: "elder",
        giver_name: "Elder Rowan",
        offer: (
            lines: [
                "Ah, a traveller! Welcome to Emberbrook, {player}.",
                "Strange lights have been seen in Whisperwood, east of here.",
            ],
            question: "Would you investigate the old shrine for us?",
            accept: "Of course!",
            decline: "Not right now.",
            accepted: [
                "Wonderful! The gate key is in the chest in my house, east of the square.",
            ],
            declined: [
                "I understand. Come back if you change your mind.",
            ],
        ),
        steps: [
            (
                done: Conditions([
                    (
                        cond: HasItem(
                            item: "key",
                            count: 1,
                        ),
                        negate: false,
                    ),
                ]),
                giver_line: "The shrine lies deep in Whisperwood. Take the key from my chest and open the east gate.",
                on_start: [
                    SetFlag(
                        name: "quest_accepted",
                        value: true,
                    ),
                ],
            ),
            (
                done: Conditions([
                    (
                        cond: Flag(
                            name: "shrine_lit",
                        ),
                        negate: false,
                    ),
                ]),
                giver_line: "The shrine lies deep in Whisperwood. Take the key from my chest and open the east gate.",
            ),
            (
                done: Talk(
                    character: "",
                    lines: [
                        "The lights have calmed! You have my thanks, brave {lad|lass}.",
                    ],
                ),
            ),
        ],
        rewards: (
            items: [
                (
                    item: "coin",
                    count: 25,
                ),
            ],
            skill_points: 2,
            actions: [
                Emote(
                    target: "self",
                    emotion: "joy",
                    seconds: 0.0,
                    wait: false,
                ),
                CallCommon(
                    id: "quest_reward",
                ),
            ],
        ),
    ),
    (
        id: "pest_control",
        title: "Pest Control",
        description: "Slimes from Whisperwood keep eating Tilda\'s deliveries. She promised 30 coins and a potion if I get rid of five of them.",
        stages: [
            "Defeat slimes in Whisperwood ({pest_slimes}/5).",
            "Return to Tilda\'s shop for the reward.",
        ],
        xp: 40,
        targets: [
            (
                map: "forest",
                name: "slime_den",
            ),
            (
                map: "shop",
                name: "tilda",
            ),
        ],
        giver: "tilda",
        giver_name: "Tilda",
        requires: [
            (
                cond: Flag(
                    name: "shrine_lit",
                ),
                negate: true,
            ),
        ],
        offer: (
            lines: [],
            question: "Slimes from Whisperwood keep eating my deliveries! Could you get rid of five of them? 30 coins and a potion are yours.",
            accept: "I\'ll do it.",
            decline: "Not right now.",
            accepted: [
                "Wonderful! Come back when it\'s done. Now, care to look at my wares?",
            ],
            declined: [
                "The offer stands. Now, care to look at my wares?",
            ],
        ),
        steps: [
            (
                done: Conditions([
                    (
                        cond: Var(
                            name: "pest_slimes",
                            op: Ge,
                            value: 5,
                        ),
                        negate: false,
                    ),
                ]),
            ),
            (
                done: Talk(
                    character: "",
                    lines: [
                        "The slimes are gone? My deliveries are safe again - thank you, {player}! Here, as promised.",
                    ],
                ),
            ),
        ],
        rewards: (
            items: [
                (
                    item: "coin",
                    count: 30,
                ),
                (
                    item: "potion",
                    count: 1,
                ),
            ],
            skill_points: 1,
            actions: [
                CallCommon(
                    id: "quest_reward",
                ),
            ],
        ),
    ),
    (
        id: "lost_cat",
        title: "The Lost Cat",
        description: "Mira\'s ginger cat Biscuit has been missing for two days. She asked me to find him.",
        stages: [
            "Ask around Emberbrook about Mira\'s cat Biscuit ({cat_clues}/2 clues).",
            "Search the old mill across the river.",
            "Bring Mira the good news.",
        ],
        xp: 30,
        targets: [
            (
                map: "",
                name: "",
            ),
            (
                map: "mill",
                name: "biscuit",
            ),
            (
                map: "village",
                name: "mira",
            ),
        ],
        giver: "mira",
        giver_name: "Mira",
        offer: (
            lines: [
                "Hi, {player}... Have you seen a ginger cat? My Biscuit has been gone for two whole days!",
            ],
            question: "Will you help me find him?",
            accept: "I\'ll find him",
            decline: "Not now",
            accepted: [
                "Thank you! Ask around - somebody must have seen him.",
            ],
            declined: [
                "Oh... okay. Biscuit, where are you...",
            ],
        ),
        steps: [
            (
                done: Conditions([
                    (
                        cond: Var(
                            name: "cat_clues",
                            op: Ge,
                            value: 2,
                        ),
                        negate: false,
                    ),
                ]),
                giver_line: "Any news of Biscuit? Bram, Old Finn or the miller might have seen him.",
                on_done: [
                    Dialog(
                        speaker: "",
                        text: "Two clues point the same way: Biscuit must be hiding in the old mill, across the river.",
                    ),
                ],
            ),
            (
                done: Talk(
                    character: "biscuit",
                    lines: [
                        "Mrrp?",
                    ],
                    speaker: "Biscuit",
                ),
                giver_line: "Any news of Biscuit? Bram, Old Finn or the miller might have seen him.",
                on_done: [
                    Dialog(
                        speaker: "",
                        text: "It\'s Biscuit! Fat and happy from the mill\'s mice. He trots off towards home.",
                    ),
                    SetFlag(
                        name: "biscuit_found",
                        value: true,
                    ),
                    SetActive(
                        target: "biscuit",
                        active: false,
                    ),
                ],
            ),
            (
                done: Talk(
                    character: "",
                    lines: [
                        "He was in the mill all along? And he\'s home now? Oh, thank you, thank you!",
                    ],
                ),
            ),
        ],
        rewards: (
            items: [
                (
                    item: "coin",
                    count: 10,
                ),
                (
                    item: "apple_pie",
                    count: 1,
                ),
            ],
            actions: [
                CallCommon(
                    id: "quest_reward",
                ),
            ],
        ),
    ),
    (
        id: "festival_bread",
        title: "Bread for the Festival",
        description: "Outlaws raided the miller\'s flour cart on the forest road. Without flour, Bram the baker can\'t bake the loaf for the harvest festival.",
        stages: [
            "Recover three sacks of flour from the raided cart on the forest road, beyond the east gate.",
            "Bake a Festival Loaf at Bram\'s oven (two flour, an egg, a jar of honey) and bring it to Bram.",
        ],
        xp: 60,
        targets: [
            (
                map: "bakery",
                name: "bram",
            ),
            (
                map: "bakery",
                name: "bram",
            ),
        ],
        giver: "bram",
        giver_name: "Bram",
        offer: (
            lines: [
                "Trouble, {player}! Outlaws raided Jorun\'s flour cart on the forest road, and the harvest festival is in three days.",
            ],
            question: "Could you bring back the flour? Three sacks would save the festival loaf.",
            accept: "Leave it to me",
            decline: "Not now",
            accepted: [
                "Bless you! The cart lies by the road past the east gate. Mind the outlaws.",
            ],
            declined: [],
        ),
        steps: [
            (
                done: Talk(
                    character: "",
                    lines: [
                        "The flour! I\'ll keep one sack for the rolls. I\'m run off my feet - bake the loaf at my oven yourself: two flour, this egg and this honey.",
                    ],
                    when: [
                        (
                            cond: HasItem(
                                item: "flour",
                                count: 3,
                            ),
                            negate: false,
                        ),
                    ],
                ),
                on_done: [
                    TakeItem(
                        item: "flour",
                        count: 1,
                    ),
                    GiveItem(
                        item: "egg",
                        count: 1,
                    ),
                    GiveItem(
                        item: "honey",
                        count: 1,
                    ),
                ],
                first_to: (
                    map: "forest",
                    name: "raided_cart",
                ),
            ),
            (
                done: Talk(
                    character: "",
                    lines: [
                        "Golden and braided, just like my grandmother\'s! The festival is saved, {player}.",
                    ],
                    when: [
                        (
                            cond: HasItem(
                                item: "festival_bread",
                                count: 1,
                            ),
                            negate: false,
                        ),
                    ],
                ),
                on_done: [
                    TakeItem(
                        item: "festival_bread",
                        count: 1,
                    ),
                ],
                first_to: (
                    map: "bakery",
                    name: "bakery_oven",
                ),
            ),
        ],
        rewards: (
            items: [
                (
                    item: "coin",
                    count: 40,
                ),
            ],
            skill_points: 1,
            actions: [
                CallCommon(
                    id: "quest_reward",
                ),
            ],
        ),
        objects: [
            (
                map: "forest",
                name: "raided_cart",
            ),
            (
                map: "forest",
                name: "cart_flour_1",
            ),
            (
                map: "forest",
                name: "cart_flour_2",
            ),
        ],
    ),
    (
        id: "herbal_remedy",
        title: "The Herbalist\'s Remedy",
        description: "Ida\'s little son Pip is ill with a fever. Wren the herbalist can brew a remedy if someone gathers the herbs for it.",
        stages: [
            "Gather feverleaf (by the forest path), bitterroot (on the pond bank) and a moonpetal (it opens only at night, in the graveyard), and bring them to Wren.",
            "Brew the Herbal Remedy at Wren\'s alchemy table and bring it to Pip.",
        ],
        xp: 70,
        targets: [
            (
                map: "apothecary",
                name: "wren",
            ),
            (
                map: "home_mira",
                name: "pip_sick",
            ),
        ],
        giver: "ida",
        giver_name: "Ida",
        offer: (
            lines: [
                "My little Pip is ill with a fever. Wren can brew a remedy, but she needs feverleaf, bitterroot and a moonpetal.",
            ],
            question: "Would you gather the herbs for her?",
            accept: "I\'ll gather them",
            decline: "Not now",
            accepted: [
                "Thank you, {player}! Bring them to Wren at the apothecary.",
            ],
            declined: [],
        ),
        steps: [
            (
                done: Talk(
                    character: "wren",
                    lines: [
                        "Feverleaf, bitterroot and a moonpetal - all three! Brew them at my alchemy table with a mortar and pestle.",
                    ],
                    when: [
                        (
                            cond: HasItem(
                                item: "feverleaf",
                                count: 1,
                            ),
                            negate: false,
                        ),
                        (
                            cond: HasItem(
                                item: "bitterroot",
                                count: 1,
                            ),
                            negate: false,
                        ),
                        (
                            cond: HasItem(
                                item: "moonpetal",
                                count: 1,
                            ),
                            negate: false,
                        ),
                    ],
                    speaker: "Wren",
                ),
                giver_line: "Please hurry, {player}. Pip\'s fever is getting worse.",
                on_done: [
                    If(
                        conditions: [
                            (
                                cond: HasItem(
                                    item: "mortar",
                                    count: 1,
                                ),
                                negate: true,
                            ),
                        ],
                        then: [
                            GiveItem(
                                item: "mortar",
                                count: 1,
                            ),
                            Dialog(
                                speaker: "",
                                text: "Wren gives you her spare mortar and pestle.",
                            ),
                        ],
                        otherwise: [],
                    ),
                ],
            ),
            (
                done: Talk(
                    character: "pip_sick",
                    lines: [
                        "Yuck, it\'s so bitter! ...Oh. Oh, my head doesn\'t hurt any more!",
                    ],
                    when: [
                        (
                            cond: HasItem(
                                item: "remedy",
                                count: 1,
                            ),
                            negate: false,
                        ),
                    ],
                    speaker: "Pip",
                ),
                giver_line: "Please hurry, {player}. Pip\'s fever is getting worse.",
                on_done: [
                    TakeItem(
                        item: "remedy",
                        count: 1,
                    ),
                    Emote(
                        target: "pip_sick",
                        emotion: "joy",
                        seconds: 3.0,
                        wait: false,
                    ),
                    Dialog(
                        speaker: "",
                        text: "Ida presses 20 coins into your hand.",
                    ),
                ],
                first_to: (
                    map: "apothecary",
                    name: "alchemy_table",
                ),
            ),
        ],
        rewards: (
            items: [
                (
                    item: "coin",
                    count: 20,
                ),
            ],
            skill_points: 1,
            actions: [
                SetFlag(
                    name: "pip_cured",
                    value: true,
                ),
                CallCommon(
                    id: "quest_reward",
                ),
            ],
        ),
    ),
    (
        id: "tavern_rumours",
        title: "Rumours at the Tavern",
        description: "Greta told me about Halvar, a miner who went into the old mine forty years ago and never came back.",
        stages: [
            "Ask Brom the smith about Halvar.",
            "Find Halvar\'s silver locket in the old mine and bring it to Brom.",
        ],
        xp: 90,
        targets: [
            (
                map: "smithy",
                name: "brom",
            ),
            (
                map: "smithy",
                name: "brom",
            ),
        ],
        steps: [
            (
                done: Talk(
                    character: "brom",
                    lines: [
                        "Halvar? Greta\'s been telling tales again. He was my friend. Forty years ago he went down into the old mine and never came back.",
                        "He always wore a silver locket with his Elsa\'s picture in it. If it\'s still down there... I\'d like to have it. For her grave.",
                    ],
                    speaker: "Brom",
                ),
            ),
            (
                done: Talk(
                    character: "brom",
                    lines: [
                        "That\'s it. That\'s Halvar\'s locket... Thank you, {player}. I\'ll lay it on Elsa\'s grave tonight. Take this - and my best edge on anything you bring me.",
                    ],
                    when: [
                        (
                            cond: HasItem(
                                item: "locket",
                                count: 1,
                            ),
                            negate: false,
                        ),
                    ],
                    speaker: "Brom",
                ),
                on_done: [
                    TakeItem(
                        item: "locket",
                        count: 1,
                    ),
                ],
                first_to: (
                    map: "mine",
                    name: "halvar_locket",
                ),
            ),
        ],
        rewards: (
            items: [
                (
                    item: "coin",
                    count: 50,
                ),
            ],
            skill_points: 1,
        ),
        objects: [
            (
                map: "mine",
                name: "halvar_locket",
            ),
        ],
    ),
    (
        id: "elven_trust",
        title: "Friend of the Elves",
        description: "The elven herbalist in the Wilds asked for wolf pelts. Help her, and the elves will count you a friend.",
        stages: [
            "Bring the elven herbalist in the Wilds two wolf pelts.",
        ],
        xp: 50,
        targets: [
            (
                map: "wilds",
                name: "wild_herbalist",
            ),
        ],
        giver: "wild_herbalist",
        giver_name: "Elven Herbalist",
        offer: (
            lines: [
                "The wolves keep digging up my herb grounds. Bring me two of their pelts, and the elves will count you a friend.",
            ],
            question: "",
            accept: "",
            decline: "",
            accepted: [],
            declined: [],
        ),
        steps: [
            (
                done: Talk(
                    character: "",
                    lines: [
                        "Two fine pelts! The wolves will trouble my herb grounds less now. Thank you, {player}.",
                        "I will tell the rangers about you. My people will know you as a friend.",
                    ],
                    when: [
                        (
                            cond: HasItem(
                                item: "wolf_pelt",
                                count: 2,
                            ),
                            negate: false,
                        ),
                    ],
                ),
                giver_line: "Two wolf pelts, {player}. The wolves roam all over the Wilds.",
                on_done: [
                    TakeItem(
                        item: "wolf_pelt",
                        count: 2,
                    ),
                ],
                first_to: (
                    map: "wilds",
                    name: "wolves_1",
                ),
            ),
        ],
        rewards: (
            actions: [
                ChangeStanding(
                    faction: "elves",
                    amount: 40,
                ),
            ],
        ),
    ),
    (
        id: "shrine_offering",
        title: "An Offering for the Shrine",
        description: "With the lights calmed, Elder Rowan remembered the old custom: a jar of honey for the shrine in Whisperwood every spring, as thanks.",
        stages: [
            "Get a jar of honey (there are beehives in the village).",
            "Leave the honey at the shrine in Whisperwood.",
            "Tell Elder Rowan.",
        ],
        xp: 50,
        targets: [
            (
                map: "village",
                name: "beehive",
            ),
            (
                map: "forest",
                name: "shrine",
            ),
            (
                map: "village",
                name: "elder",
            ),
        ],
        giver: "elder",
        giver_name: "Elder Rowan",
        requires: [
            (
                cond: Quest(
                    quest: "strange_lights",
                    check: Completed,
                    stage: 0,
                ),
                negate: false,
            ),
        ],
        offer: (
            lines: [
                "Since the lights calmed, I keep thinking of the old shrine. Our grandparents left it honey every spring, as thanks.",
                "We forgot, and maybe that is why it stirred.",
            ],
            question: "Would you bring it an offering for us?",
            accept: "Gladly",
            decline: "Another time",
            accepted: [
                "A jar of honey will do. There are beehives in the village - mind the bees.",
            ],
            declined: [
                "The shrine has waited forty years. It can wait a little longer.",
            ],
        ),
        steps: [
            (
                done: Conditions([
                    (
                        cond: HasItem(
                            item: "honey",
                            count: 1,
                        ),
                        negate: false,
                    ),
                ]),
                giver_line: "A jar of honey, {player}. The beehives are by the gardens.",
            ),
            (
                done: Reach,
                giver_line: "Leave the honey at the shrine, {player}.",
                on_done: [
                    TakeItem(
                        item: "honey",
                        count: 1,
                    ),
                    RunScript(
                        function: "shrine_offering",
                    ),
                ],
            ),
            (
                done: Talk(
                    character: "",
                    lines: [
                        "You left it an offering? Then the shrine will sleep well, and so will I.",
                        "Thank you, {player}. Emberbrook is lucky to have you.",
                    ],
                ),
            ),
        ],
        rewards: (
            items: [
                (
                    item: "coin",
                    count: 20,
                ),
            ],
            actions: [
                CallCommon(
                    id: "quest_reward",
                ),
            ],
        ),
    ),
    (
        id: "home_in_emberbrook",
        title: "A Home in Emberbrook",
        description: "Halvar\'s old stone house by the east gate has stood empty for forty years. Elder Rowan thinks it could be yours - if you put it right.",
        stages: [
            "Ask Brom the smith for the key to Halvar\'s old house.",
            "Clear the junk out of the old stone house ({junk_cleared}/3).",
            "Pay Elder Rowan 100 coins for the house.",
        ],
        xp: 80,
        targets: [
            (
                map: "smithy",
                name: "brom",
            ),
            (
                map: "stone_house",
                name: "junk_cart",
            ),
            (
                map: "village",
                name: "elder",
            ),
        ],
        giver: "elder",
        giver_name: "Elder Rowan",
        requires: [
            (
                cond: Quest(
                    quest: "shrine_offering",
                    check: Completed,
                    stage: 0,
                ),
                negate: false,
            ),
        ],
        offer: (
            lines: [
                "You have done a great deal for Emberbrook, {player}. You ought to have a roof of your own here.",
                "Halvar\'s old stone house by the east gate has stood empty since he went down into the mine. Forty years of dust and junk.",
            ],
            question: "Would you like to make it your home?",
            accept: "I would",
            decline: "Not yet",
            accepted: [
                "Splendid! Brom the smith kept Halvar\'s things - he will have the key. Clear the place out, and it is yours for a hundred coins.",
            ],
            declined: [
                "The house is going nowhere. Neither am I.",
            ],
        ),
        steps: [
            (
                done: Talk(
                    character: "brom",
                    lines: [
                        "Halvar\'s house? I kept his key all these years, hoping he\'d walk in one day and ask for it.",
                        "Take it, {player}. Better a friend lives there than the mice.",
                    ],
                ),
                giver_line: "Brom the smith kept Halvar\'s things. Ask him for the key.",
                on_done: [
                    GiveItem(
                        item: "stone_house_key",
                        count: 1,
                    ),
                ],
            ),
            (
                done: Conditions([
                    (
                        cond: Var(
                            name: "junk_cleared",
                            op: Ge,
                            value: 3,
                        ),
                        negate: false,
                    ),
                ]),
                giver_line: "Clear the junk out of the old house first, {player}. Forty years of it!",
            ),
            (
                done: Talk(
                    character: "",
                    lines: [
                        "A hundred coins, thank you. The house is yours, {player} - Halvar would be glad.",
                        "Here, a chair to start with. Tilda sells more, and you can build furniture at the sawhorse by the mill.",
                    ],
                    when: [
                        (
                            cond: HasItem(
                                item: "coin",
                                count: 100,
                            ),
                            negate: false,
                        ),
                    ],
                ),
                giver_line: "The house is yours for a hundred coins, {player}. Come back when you have them.",
                on_done: [
                    TakeItem(
                        item: "coin",
                        count: 100,
                    ),
                ],
            ),
        ],
        rewards: (
            items: [
                (
                    item: "furn_chair",
                    count: 1,
                ),
            ],
            actions: [
                RunScript(
                    function: "own_stone_house",
                ),
                CallCommon(
                    id: "quest_reward",
                ),
            ],
        ),
        objects: [
            (
                map: "stone_house",
                name: "junk_cart",
            ),
            (
                map: "stone_house",
                name: "junk_sack",
            ),
            (
                map: "stone_house",
                name: "junk_bones",
            ),
        ],
    ),
    (
        id: "hot_soup",
        title: "Hot Soup",
        description: "Elder Rowan has a cold. Greta sent me to bring him a bowl of her pumpkin stew while it is still hot.",
        stages: [
            "Bring Greta\'s pumpkin stew to Elder Rowan before it goes cold.",
        ],
        xp: 20,
        targets: [
            (
                map: "village",
                name: "elder",
            ),
        ],
        giver: "greta",
        giver_name: "Greta",
        offer: (
            lines: [
                "Elder Rowan has caught a cold and hasn\'t eaten all day, poor man.",
                "Would you take him a bowl of my pumpkin stew? But hurry - it\'s only good hot!",
            ],
            question: "Will you take it to him?",
            accept: "On my way",
            decline: "Not now",
            accepted: [
                "Here, mind the bowl. Off you go - quick, quick!",
            ],
            declined: [
                "Then I\'ll keep it warm a while longer.",
            ],
        ),
        steps: [
            (
                done: Talk(
                    character: "elder",
                    lines: [
                        "Greta\'s stew, and still steaming! Bless you, {player} - and bless her too.",
                    ],
                    when: [
                        (
                            cond: Timer(
                                name: "soup",
                                op: Gt,
                                seconds: 0,
                            ),
                            negate: false,
                        ),
                    ],
                ),
                giver_line: "Still here? The stew won\'t stay hot forever!",
                on_start: [
                    GiveItem(
                        item: "pumpkin_stew",
                        count: 1,
                    ),
                    StartTimer(
                        name: "soup",
                        seconds: 150.0,
                        shown: true,
                        function: "soup_gone_cold",
                        event: "",
                    ),
                ],
                on_done: [
                    TakeItem(
                        item: "pumpkin_stew",
                        count: 1,
                    ),
                    StopTimer(
                        name: "soup",
                    ),
                ],
            ),
        ],
        rewards: (
