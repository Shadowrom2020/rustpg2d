                count: 2,
            ),
        ],
        feature: "Harvest Hands",
        feature_text: "Farmers and villagers take you for one of their own: a farmhouse gives you a meal and a bed for a day of work.",
    ),
    (
        id: "wanderer",
        name: "Wanderer",
        description: "Roads and rivers have been your home for years; you have slept under more trees than roofs.",
