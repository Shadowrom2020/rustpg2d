(
    name: "R(ust)PG2D example",
    tile_size: 32,
    start_map: "village",
    start_spawn: "start",
    scale: 1.5,
    player: "hero",
    battle_music: "music_battle",
    sfx: (
        pickup: "pickup",
        attack: "swing",
        hit: "hit",
        hurt: "hurt",
        defeat: "defeat",
        dialog: "blip",
        portal: "door",
        open_container: "creak",
        unlock: "unlock",
        level_up: "fanfare_level_up",
        victory: "",
    ),
    inventory_size: 24,
    creation: (
        enabled: true,
        sex: Both,
        default_name: "Alex",
        body_male: "hero",
        body_female: "heroine",
        ability_methods: [
            Standard,
            PointBuy,
            Roll,
        ],
        store: "outfitter",
    ),
    day_minutes: 24.0,
    start_hour: 8.0,
    factions: (
        list: [
            (
                id: "humans",
                name: "Humans",
            ),
            (
                id: "elves",
                name: "Elves",
            ),
            (
                id: "dwarves",
                name: "Dwarves",
            ),
            (
                id: "goblins",
                name: "Goblin tribes",
            ),
            (
                id: "orcs",
                name: "Orc clans",
            ),
            (
                id: "bandits",
                name: "Bandits",
            ),
            (
                id: "wild",
                name: "Wild beasts",
            ),
            (
                id: "monsters",
                name: "Monsters",
            ),
        ],
        relations: [
            (
                a: "humans",
                b: "elves",
                attitude: Friendly,
            ),
            (
                a: "humans",
                b: "dwarves",
                attitude: Friendly,
            ),
            (
                a: "humans",
                b: "goblins",
                attitude: Hostile,
            ),
            (
                a: "humans",
                b: "orcs",
                attitude: Hostile,
            ),
            (
                a: "humans",
                b: "bandits",
                attitude: Hostile,
            ),
            (
                a: "humans",
                b: "wild",
                attitude: Hostile,
            ),
            (
                a: "humans",
                b: "monsters",
                attitude: Hostile,
            ),
            (
                a: "elves",
                b: "orcs",
                attitude: Hostile,
            ),
            (
                a: "elves",
                b: "goblins",
                attitude: Hostile,
            ),
            (
                a: "elves",
                b: "bandits",
                attitude: Hostile,
            ),
            (
                a: "elves",
                b: "wild",
                attitude: Hostile,
            ),
            (
                a: "elves",
                b: "monsters",
                attitude: Hostile,
            ),
            (
                a: "dwarves",
                b: "bandits",
                attitude: Hostile,
            ),
            (
                a: "dwarves",
                b: "monsters",
                attitude: Hostile,
            ),
            (
                a: "goblins",
                b: "orcs",
                attitude: Friendly,
            ),
        ],
    ),
    hooks: [
        (
            hook: "buy",
            function: "friend_buy_price",
            priority: 0,
        ),
        (
            hook: "sell",
            function: "friend_sell_price",
            priority: 0,
        ),
    ],
    plugins: [
        (
            id: "calendar",
            enabled: true,
        ),
        (
            id: "minimap",
            enabled: true,
        ),
    ],
    skills: (
        magic: true,
        max_mana: 20,
        mana_regen: 0.5,
    ),
    rules: (
        abilities: (15, 14, 13, 10, 12, 8),
        proficiencies: [
            "athletics",
            "perception",
            "persuasion",
            "thieves-tools",
        ],
        show_checks: true,
        food_water: false,
        forced_march: false,
        encumbrance: Plain,
        camp_item: "bedroll",
    ),
    rules_version: 4,
    progression: (
        enabled: true,
        max_level: 20,
        hit_points: Average,
        mana_per_level: 2,
    ),
    dialog_portraits: true,
    auto_emotions: true,
    companion_down: StaysDown,
    language: "en",
    languages: [
        "de",
    ],
    map_titles: {
        "apothecary": "Wren\'s Apothecary",
        "bakery": "Bram\'s Bakery",
        "chapel": "The Chapel",
        "crier_cottage": "Oswin\'s Cottage",
        "farmhouse": "The Farmhouse",
        "finn_cottage": "Finn\'s Cottage",
        "forest": "Whisperwood",
        "home_mira": "Mira\'s Home",
        "house": "Elder Rowan\'s House",
        "mill": "Jorun\'s Mill",
        "mine": "The Old Mine",
        "mine_depths": "The Deep Caves",
        "shop": "Tilda\'s Shop",
        "smithy": "Brom\'s Smithy",
        "stone_house": "The Old Stone House",
        "tavern": "The Copper Kettle",
        "tavern_upper": "The Copper Kettle, Upstairs",
        "village": "Emberbrook",
        "wilds": "The Wilds",
    },
    fonts: (
        ui: "monogram",
    ),
    skin: "wood",
    title: (
        background: Map(
            at: Some((34.0, 25.0)),
            hour: Some(20.5),
            drift: true,
        ),
        logo: Some((
            sheet: "title_logo",
            x: 0.5,
            y: 0.17,
            scale: 4.0,
        )),
        music: "music_village",
        entries: [
            NewGame,
            Continue,
            Load,
            Options,
            Achievements,
            Custom(
                label: "Credits",
                function: "roll_credits",
                detail: "Who made this game",
            ),
            Exit,
        ],
        dim: Some(0.3),
    ),
    menu: (
        entries: [
            Resume,
            Photo,
            Save,
            Load,
            Options,
            Custom(
                label: "Village life",
                function: "village_life",
                detail: "Friends, your home, achievements",
            ),
            Achievements,
            SaveAndQuit,
            QuitToTitle,
        ],
    ),
    credits: "Emberbrook\nAn example game for R(ust)PG2D\n\nMade with R(ust)PG2D, a free engine and editor for 2D role-playing games.\n\nArt, characters, sounds and music\nmade for R(ust)PG2D: its example game and starter asset library.\n\nFont\nmonogram by Vinícius Menézio (datagoblin), CC0.\n\nThank you for playing!",
    srd: true,
)