        "Dungeon wall": "Kerkermauer",
        "Dungeoneer\'s Pack": "Gewölbeausrüstung",
        "Dwarf": "Zwerg",
        "Dwarf Trader": "Zwergenhändler",
        "Dwarven Combat Training": "Zwergische Kampfausbildung",
